auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096

common:
  instance_addr: 127.0.0.1
  path_prefix: /opt/loki
  storage:
    filesystem:
      chunks_directory: /opt/loki/chunks
      rules_directory: /opt/loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

schema_config:
  configs:
    - from: 2020-10-24
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

ingester:
  # zstd compresses repetitive syslog/journald better than the gzip default,
  # at similar or lower CPU. Existing gzip chunks remain readable; only new
  # chunks use zstd.
  chunk_encoding: zstd

# Log-based alerting. Rules live on disk under /opt/loki/rules/<tenant>/
# (tenant is "fake" with auth_enabled: false), rendered from
# templates/loki-rules.yml.j2. The ruler re-reads the directory every
# poll_interval, so a rules change needs no restart. Alerts go to the same
# Alertmanager (host network) Prometheus uses, so they share the Slack
# severity routing.
ruler:
  alertmanager_url: http://localhost:9093
  enable_alertmanager_v2: true
  enable_api: true
  evaluation_interval: 1m
  poll_interval: 1m
  rule_path: /opt/loki/ruler-tmp
  storage:
    type: local
    local:
      directory: /opt/loki/rules

analytics:
 reporting_enabled: false

compactor:
  working_directory: /opt/loki/compactor
  compaction_interval: 1h
  retention_enabled: true
  retention_delete_delay: 2h
  retention_delete_worker_count: 150
  delete_request_store: filesystem

limits_config:
  # Global log retention. Sized as an operational buffer that won't grow the
  # disk unbounded once syslog from all VMs is centralized here. Loki retention
  # is time-based only (no size cap), so re-measure growth/day after syslog
  # fan-in and tune. Per-stream overrides (limits_config.retention_stream) can
  # keep noisy syslog shorter and curated streams longer if needed.
  retention_period: 90d
  # Per-stream overrides take priority over the global period above (highest
  # priority wins). Container stdout is the bulkiest, least curated source and
  # its local json-file ring buffer already covers the "what did it just
  # print" case, so it is kept for a month rather than a quarter.
  retention_stream:
    - selector: '{job="docker"}'
      priority: 10
      period: 30d
