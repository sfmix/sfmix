            count_over_time({job="journal", unit="teleport.service"} |= "SLOW TRANSACTION" [1h])
          ) > 1000
        for: 1h
        labels: {severity: warning, component: teleport}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-unit=teleport.service&var-search=SLOW%20TRANSACTION&from=now-6h&to=now
          summary: >-
            Teleport sqlite backend is slow ({{ printf "%.0f" $value }} slow txns/h)
          description: >-
            Teleport's embedded sqlite is logging over 1000 slow transactions
            an hour. Seen when the hypervisor is I/O starved
            (pve02-paulave200 iowait) or the VM disk is nearly full; auth and
            session recording latency follow.
#}
{% raw %}

      - alert: LookingGlassBackendWaiting
        expr: >
          sum by (host, unit) (
            count_over_time({job="journal", unit=~"lg-(http|cli).service"} |= "Waiting for lg-server to be ready" [15m])
          ) > 30
        for: 10m
        labels: {severity: warning, component: looking-glass}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-unit={{ $labels.unit }}&var-search=Waiting%20for%20lg-server&from=now-3h&to=now
          summary: "{{ $labels.unit }} cannot reach lg-server on {{ $labels.host }}"
          description: >-
            The looking-glass front ends have been waiting on lg-server's RPC
            for over 10 minutes -- longer than any deploy restart. Check
            `systemctl status lg-server` on alice.

      - alert: ContainerErrorBurst
        expr: >
          sum by (host, container) (
            count_over_time({job="docker", container!="loki"} |~ "(?i)(traceback|exception|\\berror\\b|\\bfatal\\b)" !~ "logger=(tsdb\\.loki|context)" [15m])
          ) > 100
        for: 10m
        labels: {severity: warning, component: docker}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-container-logs/container-logs?var-host={{ $labels.host }}&var-container={{ $labels.container }}&var-search=traceback%7Cexception%7Cerror%7Cfatal&from=now-3h&to=now
          summary: >-
            {{ $labels.container }} on {{ $labels.host }}: {{ printf "%.0f" $value }} error lines in 15m
          description: >-
            A container is emitting errors at well above its normal rate
            (100+ in 15 minutes). `docker logs --since 15m {{ $labels.container }}`
            on {{ $labels.host }} has the detail; RestartCount in
            `docker inspect` tells you whether it is also crash-looping.

      # Transit routers: a neighbor repeatedly opening BGP that we never
      # configured (or removed). Standing condition today from snappy and two
      # peering-LAN addresses toward cr1.scl02 -- fix the far side or add the
      # session; either way it should not be background noise.
      - alert: BgpUnconfiguredPeerOpens
        expr: >
          sum by (host) (
            count_over_time({job="syslog", host=~"(cr|ar)1\\..*"} |= "bgpPeerNotFound" [1h])
          ) > 20
        for: 6h
        labels: {severity: info, component: transit}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-device-logs/network-device-logs?var-host={{ $labels.host }}&var-search=bgpPeerNotFound&from=now-24h&to=now
          summary: >-
            {{ $labels.host }}: {{ printf "%.0f" $value }}/h BGP opens from unconfigured peers
          description: >-
            Nokia is logging bgpPeerNotFound at a steady rate on
            {{ $labels.host }}. The peer addresses are in the messages; they
            have a BGP session configured toward us that we do not have.

      # Peering-switch ACL drops of member Router Advertisements are a
      # standing condition (see the disabled IxLanCriticalProtocolSeen rule in
      # prometheus/templates/rules/lan-hygiene.rules.yml.j2 for why) and are
      # already surfaced on the portal's LAN Events page. Re-enable when the
      # fabric is clean enough that a new source is worth a page.
      #
      # - alert: PeeringPortDiscoveryProtocolDropped
      #   expr: >
      #     sum by (host) (count_over_time({job="syslog", host=~"switch.*"} |= "DROP_DISCOVERY_PROTOCOLS" [1h])) > 0
      #   for: 1h
      #   labels: {severity: info, component: peering-lan}
{% endraw %}
