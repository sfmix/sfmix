{#
  Loki ruler alert rules (LogQL), rendered by Ansible into
  /opt/loki/rules/fake/sfmix.yml. Same conventions as the Prometheus rules:
  Go-template expressions Loki evaluates ({{ $labels }}, {{ $value }}) sit
  inside {% raw %}...{% endraw %}; bare {{ ... }} are Ansible.

  Alerts are delivered through the same Alertmanager as Prometheus, so the
  `severity` label picks the Slack channel and `component` drives grouping.

  Cost model: every expression below is a metric query over a short range
  (<= 1h, or 30m offset 1d) across a few thousand lines at most, evaluated
  once a minute (silence checks every 5m). Keep new rules in that envelope;
  scans over [24h]+ belong in a dashboard, not the ruler.
#}
---
groups:
  # ── Pipeline health ──────────────────────────────────────────────────
  # "Missing sender" is only a meaningful signal where a baseline is
  # guaranteed. journald hosts always have one: cron/pam sessions, systemd
  # timers and sshd emit well under hourly on every VM and hypervisor, so a
  # 2h gap means Alloy, journald, the network path or the host itself is
  # down. The list is the Ansible log_agent group -- the same hosts the
  # deploy playbook targets -- so onboarding a host onboards its alert.
  #
  # Appliances (switches, routers, PDUs, OpenBSD) are NOT in this list on
  # purpose: a healthy Arista switch may say nothing for days, so per-device
  # silence is noise. Their reachability is Prometheus's job (snmp up,
  # PduUnreachable); here we only watch the syslog *receiver* as a whole,
  # since the nine mgmt-gws alone log ~2k lines/day each -- an empty 30m
  # window across every appliance means syslog-ng/promtail broke.
  - name: sfmix-log-pipeline
    interval: 5m
    rules:
{% for h in groups['log_agent'] | sort %}
      - alert: LogSenderSilent
        expr: absent_over_time({job="journal", host="{{ h }}"}[2h])
        for: 10m
        labels: {severity: warning, component: logging, host: "{{ h }}"}
        annotations:
          summary: "No journal logs from {{ h }} for 2h"
          description: >-
            Loki has received nothing under job="journal" from {{ h }} for two
            hours. Every journald host emits at least hourly (cron, pam,
            timers), so either the host is down, Alloy stopped, or the push
            path to metrics.oob is broken. Check `systemctl status alloy` and
            `journalctl -u alloy -n 50` on the host.
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ h }}&from=now-12h&to=now
{% endfor %}
{% raw %}
      - alert: SyslogReceiverSilent
        expr: absent_over_time({job="syslog"}[30m])
        for: 5m
        labels: {severity: critical, component: logging}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-log-pipeline/log-pipeline?from=now-6h&to=now
          summary: "No appliance syslog reached Loki in 30m"
          description: >-
            Not one line under job="syslog" from any network device or OpenBSD
            host in 30 minutes; the mgmt-gws alone normally log every few
            minutes. Check the syslog-ng and promtail containers on
            metrics.sfo02 (`docker logs --since 30m syslog-ng`).

      # Protects the metrics host's I/O: the point of centralizing is not to
      # have one runaway sender turn Loki into the bottleneck. Alloy already
      # rate-limits containers at the source; this catches journald/syslog
      # floods and anything that slips past.
      - alert: LogStreamFlood
        expr: >
          topk(3,
            sum by (host, unit, container) (rate({job=~"journal|docker|syslog"}[5m]))
          ) > 30
        for: 10m
        labels: {severity: warning, component: logging}
        annotations:
          dashboard: >-
            {{ if $labels.container }}https://grafana.sfmix.org/d/sfmix-container-logs/container-logs?var-host={{ $labels.host }}&var-container={{ $labels.container }}{{ else }}https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-unit={{ $labels.unit }}{{ end }}&from=now-3h&to=now
          summary: >-
            {{ $labels.host }} {{ $labels.unit }}{{ $labels.container }} logging
            {{ printf "%.0f" $value }} lines/s for 10m
          description: >-
            One stream is sustaining over 30 lines/s (~2.6M lines/day). Find
            the repeating message and either fix the source or add a
            stage.drop for it in roles/grafana_alloy; if it must be kept,
            give it a short retention_stream in loki-config.

      - alert: LogVolumeSpike
        expr: >
          sum by (host) (count_over_time({job=~"journal|docker"}[30m])) > 3000
            and on (host)
          sum by (host) (count_over_time({job=~"journal|docker"}[30m]))
            > 4 * sum by (host) (count_over_time({job=~"journal|docker"}[30m] offset 1d))
        for: 15m
        labels: {severity: info, component: logging}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&from=now-24h&to=now
          summary: >-
            {{ $labels.host }} log volume is {{ printf "%.0f" $value }} lines/30m, >4x yesterday
          description: >-
            Something on {{ $labels.host }} started talking a lot more than it
            did at this time yesterday. Usually a crash loop, a retry storm or
            a new debug flag. Explore the host's streams by unit/container to
            find the new message template.

  # ── Host health from logs ────────────────────────────────────────────
  # Self-reference: this stack logs the searches made against it, so a
  # pattern rule can match the act of looking for its own pattern. Three
  # things echo a search back into the logs; all are filtered out below, on
  # the principle that a rule which greps for a string must never count a
  # line that merely *quotes* that string:
  #
  #   container="loki"       Loki echoes every expression it evaluates.
  #   logger=tsdb.loki       Grafana logs the LogQL of every datasource
  #                          query, verbatim.
  #   logger=context         Grafana's access log carries referer=, and an
  #                          alert's own dashboard link puts the pattern in
  #                          the URL as var-search=.
  #   COMMAND= / Invoked with
  #                          sudo and Ansible log full command lines to the
  #                          journal, so `sudo grep <pattern>` on a host
  #                          lands <pattern> in job="journal".
  #
  # The Grafana filters key on logger= rather than dropping container=
  # "grafana" wholesale, because a real Grafana panic goes to stderr with no
  # logger= field at all and must still trip ProcessCrash. Opening the
  # container-logs dashboard used to fire ProcessCrash against grafana
  # within three seconds -- the alert's own runbook link was the trigger.
  - name: sfmix-log-host-health
    rules:
      - alert: KernelOomKill
        expr: >
          sum by (host) (
            count_over_time({job="journal"} |= "Out of memory: Killed process" !~ "COMMAND=|Invoked with" [15m])
          ) > 0
        labels: {severity: warning, component: host}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-search=Out%20of%20memory&from=now-6h&to=now
          summary: "OOM killer fired on {{ $labels.host }}"
          description: >-
            The kernel killed a process for memory on {{ $labels.host }} in the
            last 15 minutes ({{ printf "%.0f" $value }} kill(s)). Whatever died
            was probably restarted by systemd/docker and lost state; size the
            VM or cap the offender.

      - alert: ProcessCrash
        expr: >
          sum by (host, unit, container) (
            count_over_time({job=~"journal|docker", container!="loki"} |~ "(?i)(segfault|core dumped|dumped core|code=dumped|panic: |panicked at |fatal error: |runtime error: )" !~ "logger=(tsdb\\.loki|context)|COMMAND=|Invoked with" [15m])
          ) > 0
        labels: {severity: warning, component: host}
        annotations:
          dashboard: >-
            {{ if $labels.container }}https://grafana.sfmix.org/d/sfmix-container-logs/container-logs?var-host={{ $labels.host }}&var-container={{ $labels.container }}{{ else }}https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-unit={{ $labels.unit }}{{ end }}&var-search=segfault%7Ccore%20dumped%7Cdumped%20core%7Ccode%3Ddumped%7Cpanic%7Cfatal%20error%7Cruntime%20error&from=now-6h&to=now
          summary: "Crash signature on {{ $labels.host }} ({{ $labels.unit }}{{ $labels.container }})"
          description: >-
            A segfault / core dump / Go or Rust panic was logged. Check the
            unit or container's recent output for the trace. systemd reports
            a dump as `code=dumped, status=<n>/<SIG>` on the unit line rather
            than the words "core dumped", and journald keeps only that line
            once the coredump is vacuumed -- so read the unit's log around
            the timestamp, not just the matching line.

      - alert: SystemdUnitFailed
        expr: >
          sum by (host) (
            count_over_time({job="journal", unit="init.scope"} |= "entered failed state" !~ "motd-news|snapd\\.failure|openipmi" [1h])
          ) > 0
        for: 5m
        labels: {severity: info, component: host}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-unit=init.scope&var-search=entered%20failed%20state&from=now-6h&to=now
          summary: "A systemd unit failed on {{ $labels.host }}"
          description: >-
            {{ printf "%.0f" $value }} unit failure(s) in the last hour on
            {{ $labels.host }} (motd-news / snapd noise excluded). Run
            `systemctl --failed` there.

      - alert: SmartAttributeFailing
        expr: >
          sum by (host) (
            count_over_time({job="journal", unit="smartmontools.service"} |~ "Failed SMART|Currently unreadable|Offline uncorrectable|FAILED SMART self-check" [1h])
          ) > 0
        for: 30m
        labels: {severity: warning, component: storage}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-unit=smartmontools.service&var-search=Failed%20SMART%7Cunreadable%7Cuncorrectable&from=now-24h&to=now
          summary: "smartd reports a failing disk on {{ $labels.host }}"
          description: >-
            smartd on {{ $labels.host }} is logging a failed attribute or
            pending/uncorrectable sectors (routine "Prefailure Attribute
            changed" wear ticks are deliberately not matched). Identify the
            device in the message and check whether it is a pool member
            (`zpool status`) or a stray disk to pull.

      - alert: ZfsPoolUnhealthy
        expr: >
          sum by (host) (
            count_over_time({job="journal"} |~ "(?i)(zed|zfs).*(DEGRADED|FAULTED|UNAVAIL|checksum error|io error)" !~ "COMMAND=|Invoked with" [30m])
          ) > 0
        labels: {severity: critical, component: storage}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-search=zed%7Czfs%7CDEGRADED%7CFAULTED&from=now-6h&to=now
          summary: "ZFS event on {{ $labels.host }}"
          description: >-
            zed logged a degraded/faulted vdev or data errors on
            {{ $labels.host }}. Run `zpool status -v` immediately; VM disks
            live on these pools.

      - alert: CertbotRenewFailed
        expr: >
          sum by (host) (
            count_over_time({job="journal"} |= "certbot" |~ "(?i)(error|failed|permission denied)" !~ "COMMAND=|Invoked with" [1h])
          ) > 0
        for: 5m
        labels: {severity: warning, component: tls}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-search=certbot&from=now-24h&to=now
          summary: "certbot errored on {{ $labels.host }}"
          description: >-
            A certbot run on {{ $labels.host }} logged an error in the last
            hour. Renewal is owned by the packaged certbot.timer, so treat this
            as a real renewal failure: check `systemctl status certbot.service`
            and /var/log/letsencrypt. A "Permission denied" on
            .certbot.lock means something is running `certbot renew`
            unprivileged -- look for a stray per-user crontab in
            /var/spool/cron/crontabs and remove it (certbot_auto_renew is
            false fleet-wide so Ansible no longer installs one).

      - alert: UnattendedUpgradesError
        expr: >
          sum by (host) (
            count_over_time({job="unattended-upgrades"} |~ "(ERROR|(?i:dpkg.*(error|failed))|Installing the upgrades failed)" != "No error reported" [6h])
          ) > 0
        labels: {severity: warning, component: host}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-search=ERROR%7Cfailed&from=now-24h&to=now
          summary: "unattended-upgrades failed on {{ $labels.host }}"
          description: >-
            apt's automatic upgrade on {{ $labels.host }} logged an error;
            the host may be stuck half-upgraded. Check
            /var/log/unattended-upgrades/ and `apt -f install`.

      - alert: SshBruteForce
        expr: >
          sum by (host) (
            count_over_time({job=~"journal|syslog"} |= "Failed password for" !~ "COMMAND=|Invoked with" [1h])
          ) > 500
        for: 30m
        labels: {severity: info, component: security}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-search=Failed%20password&from=now-6h&to=now
          summary: >-
            {{ $labels.host }}: {{ printf "%.0f" $value }} failed SSH passwords/hour
          description: >-
            Sustained password guessing against sshd on {{ $labels.host }}.
            Password auth should be off everywhere (OpenBSD's default is on;
            set `PasswordAuthentication no` in sshd_config); if it already
            is, this is just noise to rate-limit at the firewall.

  # ── Application / platform ───────────────────────────────────────────
  - name: sfmix-log-apps
    rules:
      - alert: ProxmoxBackupFailed
        expr: >
          sum by (host) (
            count_over_time({job="journal", host=~"pve.*", unit="pvescheduler.service"} |~ "ERROR:|Backup job finished with errors|Backup of VM .* failed" [30m])
          ) > 0
        labels: {severity: warning, component: backups}
        annotations:
          dashboard: >-
            https://grafana.sfmix.org/d/sfmix-host-logs/host-logs?var-host={{ $labels.host }}&var-unit=pvescheduler.service&var-search=ERROR%7Cfailed%7Cerrors&from=now-24h&to=now
          summary: "vzdump reported a failure on {{ $labels.host }}"
          description: >-
            pvescheduler on {{ $labels.host }} logged a backup error (a good
            night ends with "INFO: Backup job finished successfully"). See the
            task log in the PVE UI (Datacenter -> Backup) or /var/log/vzdump/.

{% endraw %}
