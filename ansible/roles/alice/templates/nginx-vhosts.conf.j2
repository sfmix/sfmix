{{ ansible_managed | comment }}

# HTTP to HTTPS redirect
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# Alice LG (alice.sfmix.org)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ alice_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ alice_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ alice_domain }}/privkey.pem;
    ssl_dhparam /etc/ssl/certs/dhparam.pem;

    # Alice is a live BGP tool, not content worth indexing. Crawlers (Googlebot
    # especially) were walking /search pagination endlessly, each hit fanning
    # out into route-server lookups.
    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\n{% for path in alice_robots_disallow %}Disallow: {{ path }}\n{% endfor %}";
    }

    # Static assets. Alice serves these with no cache headers, so every visit
    # was a full cold load (~20 requests). /static/ files are content-hashed
    # by the frontend build and safe to cache indefinitely; theme and font
    # files change only when the theme repo is redeployed.
    location /static/ {
        proxy_pass http://127.0.0.1:7340;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~ ^/(theme|assets)/ {
        proxy_pass http://127.0.0.1:7340;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age={{ alice_static_cache_max_age }}";
    }

    location / {
        limit_req zone=ip burst={{ alice_rate_limit_burst }}{% if alice_rate_limit_nodelay %} nodelay{% else %} delay={{ alice_rate_limit_delay }}{% endif %};
        proxy_pass http://127.0.0.1:7340;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

{% for vhost in alice_additional_vhosts %}
# {{ vhost.domain }}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ vhost.domain }};

    ssl_certificate /etc/letsencrypt/live/{{ vhost.domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ vhost.domain }}/privkey.pem;
    ssl_dhparam /etc/ssl/certs/dhparam.pem;

    location / {
{% if vhost.rate_limit | default(true) %}
        limit_req zone=ip burst={{ vhost.rate_limit_burst | default(12) }}{% if vhost.rate_limit_nodelay | default(false) %} nodelay{% else %} delay={{ vhost.rate_limit_delay | default(8) }}{% endif %};
{% endif %}
        proxy_pass http://127.0.0.1:{{ vhost.upstream_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if vhost.proxy_connect_timeout is defined %}
        proxy_connect_timeout {{ vhost.proxy_connect_timeout }};
{% endif %}
{% if vhost.proxy_read_timeout is defined %}
        proxy_read_timeout {{ vhost.proxy_read_timeout }};
{% endif %}
{% if vhost.proxy_send_timeout is defined %}
        proxy_send_timeout {{ vhost.proxy_send_timeout }};
{% endif %}
{% if vhost.extra_location_config is defined %}
        {{ vhost.extra_location_config | indent(8) }}
{% endif %}
    }
}

{% endfor %}
