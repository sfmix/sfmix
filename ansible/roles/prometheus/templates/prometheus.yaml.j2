global:
    scrape_interval: 15s
    scrape_timeout: 10s
    evaluation_interval: 15s
    # Required by the Thanos sidecar: it stamps these on every block it ships,
    # and the bucket keys series by them (design doc 012).
    external_labels:
        prometheus: {{ inventory_hostname }}
rule_files:
    - /opt/prometheus/rules/*.yml
# Firing alerts are pushed to the local Alertmanager (deployed by the
# `alertmanager` role as a sibling container on this host), which handles
# grouping, silencing, and Slack delivery. Without this block Prometheus
# only shows alerts on its own /alerts page and notifies nobody.
alerting:
    alertmanagers:
        - static_configs:
              - targets:
                    - 127.0.0.1:9093
scrape_configs:
    # SNMP polling of the peering switches via snmp_exporter. Targets are
    # enumerated from NetBox by the netbox-prometheus-sd timer (file_sd).
    # some switches (e.g. switch03/04.sjc01) rate-limit SNMP and take ~45s
    # for a walk that others answer in 5s — hence the split into two jobs
    # (interfaces vs health) with generous timeouts, so neither walk alone
    # busts the scrape deadline.
    - job_name: snmp-eos
      scrape_interval: 60s
      scrape_timeout: 55s
      metrics_path: /snmp
      params:
          module: [if_mib]
          auth: [sfmix_v2c]
      file_sd_configs:
          - files:
              - /opt/prometheus/file_sd/snmp_targets.json
      relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [__param_target]
            target_label: host          # matches the sflow series' FQDN label
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: 127.0.0.1:9116
      metric_relabel_configs:
          - source_labels: [ifName]     # match the sflow/portal join key
            target_label: ifname
          - regex: ifName
            action: labeldrop
    - job_name: snmp-eos-health
      scrape_interval: 120s
      scrape_timeout: 110s
      metrics_path: /snmp
      params:
          module: [eos_health]
          auth: [sfmix_v2c]
      file_sd_configs:
          - files:
              - /opt/prometheus/file_sd/snmp_targets.json
      relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [__param_target]
            target_label: host
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: 127.0.0.1:9116
    # Device wall clock (HOST-RESOURCES-MIB hrSystemDate), compared against
    # the scrape timestamp by clock.rules.yml to catch NTP drift. One GET in
    # its own job, kept off the slow health walk so the reading is taken
    # within a second of the scrape start.
    - job_name: snmp-clock
      scrape_interval: 60s
      scrape_timeout: 20s
      metrics_path: /snmp
      params:
          module: [clock]
          auth: [sfmix_v2c]
      file_sd_configs:
          - files:
              - /opt/prometheus/file_sd/snmp_targets.json
      relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [__param_target]
            target_label: host
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: 127.0.0.1:9116
    # SNMP polling of the PDUs (mixed vendors) via snmp_exporter. Targets come
    # from the netbox-prometheus-sd-pdu timer, which stamps each with the right
    # snmp_exporter `module` (ServerTech Sentry3 vs Raritan PDU2) from the
    # NetBox manufacturer. One job serves the whole fleet: the per-target
    # `module` label is relabeled to __param_module. `vendor`/`site`/`device`
    # ride along as series labels; the pdu:* recording rules normalise the two
    # vendors' native metrics into common base-SI series.
    - job_name: snmp-pdu
      scrape_interval: 60s
      scrape_timeout: 55s
      metrics_path: /snmp
      params:
          auth: [sfmix_v2c]
      file_sd_configs:
          - files:
              - /opt/prometheus/file_sd/pdu_targets.json
      relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [__param_target]
            target_label: instance
          - source_labels: [module]     # vendor-aware: NetBox manufacturer -> module
            target_label: __param_module
          - target_label: __address__
            replacement: 127.0.0.1:9116
    # Portal metrics: NetBox-cache health + sfmix_peering_port_info (the
    # participant/ASN attribution joined onto SNMP series by recording rules).
    - job_name: ixp-portal
      scheme: https
      metrics_path: /metrics/
      scrape_interval: 60s
      static_configs:
      - targets:
          - portal.sfmix.org
    - job_name: sflow-rt-ifcounters
      metrics_path: /prometheus/metrics/ALL/ifinoctets,ifoutoctets,ifinutilization,ifoututilization,ifinerrors,ifouterrors,ifindiscards,ifoutdiscards/txt
      scheme: http
      scrape_interval: 5s
      scrape_timeout: 4s
      static_configs:
      - targets:
          - metrics.sfo02.sfmix.org:8008
      metric_relabel_configs:
          - source_labels: ['agent', 'datasource']
            separator: ':'
            target_label: instance
    - job_name: sflow-rt-ixp-metrics
      metrics_path: /app/ixp-metrics/scripts/metrics.js/prometheus/txt
      scheme: http
      scrape_interval: 5s
      scrape_timeout: 4s
      static_configs:
      - targets:
          - metrics.sfo02.sfmix.org:8008
    - job_name: sflow-rt-pre-amp
      metrics_path: /app/prometheus/scripts/export.js/flows/ALL/txt
      scheme: http
      scrape_interval: 10s
      scrape_timeout: 4s
      static_configs:
        - targets:
          - metrics.sfo02.sfmix.org:8008
      params:
        metric: ["pre_amp_suspect_frames"]
        key: ["udpsourceport", "udpdestinationport"]
        label: ["udp_source_port", "udp_destination_port"]
        value: ["frames"]
        aggMode: ["edge"]
        filter: ["udpsourceport=80,443&udpdestinationport=17,19,53,111,123,161,389,520,1900,11211"]
        # This should at least be sized at the product of the source and destination ports
        maxFlows: ["100"]
    - job_name: sflow-rt-drops
      metrics_path: /app/prometheus/scripts/export.js/flows/ALL/txt
      scheme: http
      scrape_interval: 10s
      scrape_timeout: 4s
      static_configs:
        - targets:
          - metrics.sfo02.sfmix.org:8008
      params:
        metric: ["dropped_packets"]
        key: ["node:inputifindex","ifname:inputifindex","reason","stack","macsource","macdestination","null:vlan:untagged","null:[or:ipsource:ip6source]:none","null:[or:ipdestination:ip6destination]:none","null:[or:icmptype:icmp6type:ipprotocol:ip6nexthdr]:none"]
        label: ["switch","port","reason","stack","macsource","macdestination","vlan","src","dst","protocol"]
        value: ["frames"]
        dropped: ["true"]
        maxFlows: ["20"]
        minValue: ["0.001"]
    - job_name: sflow-rt-as40271
      metrics_path: /app/prometheus/scripts/export.js/flows/ALL/txt
      scheme: http
      scrape_interval: 10s
      scrape_timeout: 4s
      static_configs:
        - targets:
          - metrics.sfo02.sfmix.org:8008
      params:
        metric: ["as40271"]
        key: ["asn:[or:ipsource:ip6source]:both","asn:[or:ipdestination:ip6destination]:both","uc:[first:stack:.:ip:ip6]"]
        label: ["source", "destination","protocol"]
        value: ["bytes"]
        scale: ["8"]
        aggMode: ["edge"]
        filter: ["(macsource=9C47F46D4231,9C47F46D2631|macdestination=9C47F46D4231,9C47F46D2631)&first:stack:.:mpls=null"]
        maxFlows: ["100"]
    - job_name: netbox
      scheme: https
      scrape_interval: 10s
      scrape_timeout: 5s
      static_configs:
      - targets:
        - netbox.sfmix.org
    - job_name: mqtt2prometheus-air-sensor
      scheme: http
      scrape_interval: 5s
      scrape_timeout: 4s
      static_configs:
      - targets:
        - metrics.sfo02.sfmix.org:9641
      metric_relabel_configs:
        - source_labels: [sensor]
          regex: '(sfo01|sfo02|scl05)'
          target_label: facility_operator
          replacement: digital_realty
        - source_labels: [sensor]
          regex: '(fmt01)'
          target_label: facility_operator
          replacement: hurricane_electric
        - source_labels: [sensor]
          regex: '(scl01)'
          target_label: facility_operator
          replacement: qts
        - source_labels: [sensor]
          regex: '(scl02|sjc02)'
          target_label: facility_operator
          replacement: coresite
        - source_labels: [sensor]
          regex: '(sjc01)'
          target_label: facility_operator
          replacement: equinix
        - source_labels: [sensor]
          regex: '(scl04)'
          target_label: facility_operator
          replacement: opencolo
    # Served-certificate expiry, probed from outside via blackbox_exporter.
    # The relabel dance is the standard blackbox pattern: the configured target
    # becomes the ?target= parameter and the `instance` label, while the actual
    # scrape address is redirected to the exporter itself.
    #
    # Two jobs, one per IP family: a cert is per-name, but the v4 and v6
    # listeners are separate sockets and can diverge (one reloaded, one not).
    # `probe_ssl_earliest_cert_expiry` is what the tls.rules.yml alerts read.
{% for family, module in [('', 'tls_connect'), ('-ipv6', 'tls_connect_ipv6')] %}
    - job_name: blackbox-tls{{ family }}
      metrics_path: /probe
      scrape_interval: 120s
      scrape_timeout: 15s
      params:
          module: [{{ module }}]
      static_configs:
          - targets:
{% for target in blackbox_tls_targets %}
{% if not (family == '-ipv6' and target in blackbox_tls_ipv6_exclude | default([])) %}
              - {{ target }}
{% endif %}
{% endfor %}
      relabel_configs:
          - source_labels: [__address__]
            target_label: __param_target
          - source_labels: [__param_target]
            target_label: instance
          - target_label: __address__
            replacement: 127.0.0.1:{{ blackbox_exporter_listen_port | default(9115) }}
{% endfor %}
    - job_name: bird_exporer
      scheme: http
      scrape_interval: 60s
      scrape_timeout: 15s
      static_configs:
        - targets:
            - 10.1.1.18:9324
    # lg-neighborhood-watch on rs-linux (mgmt IP): ARP/NDP sensor health plus
    # the LAN-hygiene (BUM) detection counters that drive the
    # lan-hygiene.rules.yml alerts (design doc 008).
    - job_name: lg-neighborhood-watch
      scheme: http
      scrape_interval: 60s
      scrape_timeout: 15s
      static_configs:
        - targets:
            - 10.1.1.18:29185
    # Loki (sibling container, host network): ingest rates, discarded
    # samples by reason, ingester/ruler internals. Alloy agents are NOT
    # scraped -- they remote_write their self-metrics into this Prometheus.
    # Host metrics come from the standalone node_exporter (job="node", below).
    - job_name: loki
      scheme: http
      scrape_interval: 30s
      scrape_timeout: 10s
      static_configs:
        - targets:
            - 127.0.0.1:3100
          labels:
            host: metrics.sfo02.sfmix.org
    # Thanos (design doc 012): sidecar + query here, store gateway + compactor
    # next to the bucket on the archive host.
    - job_name: thanos
      scheme: http
      scrape_interval: 30s
      scrape_timeout: 10s
      static_configs:
        - targets:
            - 127.0.0.1:{{ thanos_sidecar_http_port }}
          labels: {host: {{ inventory_hostname }}, thanos_component: sidecar}
        - targets:
            - 127.0.0.1:{{ thanos_query_http_port }}
          labels: {host: {{ inventory_hostname }}, thanos_component: query}
        - targets:
            - {{ telemetry_archive_host }}:{{ hostvars[telemetry_archive_host].metrics_archive_thanos_store_http_port | default(10902) }}
          labels: {host: {{ telemetry_archive_host }}, thanos_component: store}
        - targets:
            - {{ telemetry_archive_host }}:{{ hostvars[telemetry_archive_host].metrics_archive_thanos_compact_http_port | default(10912) }}
          labels: {host: {{ telemetry_archive_host }}, thanos_component: compact}
    # Garage S3 holding the Thanos bucket (admin API /metrics, bearer token).
    - job_name: garage
      scheme: http
      scrape_interval: 60s
      scrape_timeout: 10s
      authorization:
        credentials: {{ garage_metrics_token }}
      static_configs:
{% for h in groups['metrics_archive'] | sort %}
        - targets:
            - {{ hostvars[h].ansible_host | default(h) }}:{{ garage_admin_port }}
          labels:
            host: {{ h }}
{% endfor %}
    # node_exporter on every server and hypervisor (roles/sfmix_server,
    # tasks/node_exporter.yml), scraped over the address Ansible manages the
    # host on, behind basic auth. `instance` is rewritten to the inventory
    # name so it equals `host` -- the label contract the Linux Hosts / Host
    # View dashboards and node.rules.yml are written against. Opt a host out
    # with sfmix_node_exporter_enabled: false in its host_vars.
    - job_name: node
      scheme: http
      scrape_interval: 30s
      scrape_timeout: 10s
      basic_auth:
        username: {{ sfmix_node_exporter_basic_auth_user | default('prometheus') }}
        password: {{ sfmix_node_exporter_basic_auth_password }}
      static_configs:
{% for h in (groups['servers'] + groups['proxmox_hypervisors']) | unique | sort %}
{% if hostvars[h].sfmix_node_exporter_enabled | default(true) %}
        - targets:
            - "{{ hostvars[h].ansible_host | default(h) }}:{{ hostvars[h].sfmix_node_exporter_port | default(9100) }}"
          labels:
            host: {{ h }}
{% endif %}
{% endfor %}
      relabel_configs:
          - source_labels: [host]
            target_label: instance
