{#
  Fleet backup freshness (design doc 013). The seal job on the backup target
  (roles/backup_target) writes sfmix_backup_* via node_exporter's textfile
  collector. One BackupStale rule per `backup_push` host, so a client whose
  series never appeared (absent) alerts the same as a stale one.
#}
---
groups:
  - name: sfmix-backup-alerts
    rules:
{% for c in groups['backup_push'] | default([]) | sort %}
{%   set name = hostvars[c].backup_push_name %}
{%   set max_h = hostvars[c].backup_push_max_age_hours | int %}
      - alert: BackupStale
        expr: >
          (time() - max(sfmix_backup_last_timestamp_seconds{client="{{ name }}"})) > {{ max_h * 3600 }}
          or absent(sfmix_backup_last_timestamp_seconds{client="{{ name }}"})
        for: 30m
        labels: {severity: warning, component: backups, client: "{{ name }}"}
        annotations:
          summary: "No fresh backup from {{ name }} in {{ max_h }}h"
          description: >-
            The newest sealed bundle from {{ c }} on {{ hostvars[c].backup_push_target }}
            is older than {{ max_h }}h, or there is none. Check
            `systemctl status sfmix-backup-push` / `journalctl -u sfmix-backup-push`
            on {{ c }}, then `journalctl -t sfmix-backup-seal` on the target.
{% endfor %}
{% raw %}
      - alert: BackupSealerStale
        expr: >
          (time() - sfmix_backup_seal_last_run_timestamp_seconds) > 3600
        for: 15m
        labels: {severity: warning, component: backups}
        annotations:
          summary: "Backup seal job on {{ $labels.host }} has not run for an hour"
          description: >-
            sfmix-backup-seal.timer on {{ $labels.host }} is not completing, so
            uploads sit in client-writable incoming/ and freshness metrics are
            frozen. `systemctl status sfmix-backup-seal` on {{ $labels.host }}.
{% endraw %}
