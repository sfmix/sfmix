{#
  Fleet backup freshness (design doc 013). The seal job on the backup target
  (roles/backup_target) writes sfmix_backup_* via node_exporter's textfile
  collector. One BackupStale rule per `backup_push` host, so a client whose
  series never appeared (absent) alerts the same as a stale one.
  sfmix:backup_max_age_seconds publishes each client's window so the Backups
  dashboard (gen_nms_dashboards.py / nms_backup_dashboards.py) can show
  "% of window used" and list clients that have never reported.
#}
---
groups:
  - name: sfmix-backup-windows
    rules:
{% for c in groups['backup_push'] | default([]) | sort %}
      - record: sfmix:backup_max_age_seconds
        expr: vector({{ (hostvars[c].backup_push_max_age_hours | int) * 3600 }})
        labels: {client: "{{ hostvars[c].backup_push_name }}", push_host: "{{ c }}"}
{% endfor %}

  - name: sfmix-backup-alerts
    rules:
{% for c in groups['backup_push'] | default([]) | sort %}
{%   set name = hostvars[c].backup_push_name %}
{%   set max_h = hostvars[c].backup_push_max_age_hours | int %}
      - alert: BackupStale
        expr: >
          (time() - max(sfmix_backup_last_timestamp_seconds{client="{{ name }}"})) > {{ max_h * 3600 }}
          or absent(sfmix_backup_last_timestamp_seconds{client="{{ name }}"})
        for: 30m
        labels: {severity: warning, component: backups, client: "{{ name }}"}
        annotations:
          dashboard: https://grafana.sfmix.org/d/sfmix-backups/backups?from=now-2d&to=now
          summary: "No fresh backup from {{ name }} in {{ max_h }}h"
          description: >-
            The newest sealed bundle from {{ c }} on {{ hostvars[c].backup_push_target }}
            is older than {{ max_h }}h, or there is none. Check
            `systemctl status sfmix-backup-push` / `journalctl -u sfmix-backup-push`
            on {{ c }}, then `journalctl -t sfmix-backup-seal` on the target.
{% endfor %}
{% raw %}
      - alert: BackupSealerStale
        expr: >
          (time() - sfmix_backup_seal_last_run_timestamp_seconds) > 3600
        for: 15m
        labels: {severity: warning, component: backups}
        annotations:
          dashboard: https://grafana.sfmix.org/d/sfmix-backups/backups?from=now-2d&to=now
          summary: "Backup seal job on {{ $labels.host }} has not run for an hour"
          description: >-
            sfmix-backup-seal.timer on {{ $labels.host }} is not completing, so
            uploads sit in client-writable incoming/ and freshness metrics are
            frozen. `systemctl status sfmix-backup-seal` on {{ $labels.host }}.

      - alert: BackupQuarantined
        expr: sfmix_backup_quarantined_files > 0
        for: 5m
        labels: {severity: warning, component: backups}
        annotations:
          dashboard: https://grafana.sfmix.org/d/sfmix-backups/backups?from=now-2d&to=now
          summary: "{{ $value }} upload(s) from {{ $labels.client }} failed verification"
          description: >-
            An upload from {{ $labels.client }} failed its zstd integrity check
            and was moved to {{ $labels.client }}/quarantine/ on {{ $labels.host }}
            instead of the archive. `journalctl -t sfmix-backup-seal -p err` there
            says which. Inspect it, fix the cause on the client, then delete it from
            quarantine/ to clear this. It ages out after the retention period otherwise.

      - alert: BackupArchiveCorrupt
        expr: sfmix_backup_verify_failed_files > 0
        labels: {severity: critical, component: backups}
        annotations:
          dashboard: https://grafana.sfmix.org/d/sfmix-backups/backups?from=now-2d&to=now
          summary: "{{ $value }} sealed backup(s) of {{ $labels.client }} are corrupt"
          description: >-
            The weekly sfmix-backup-verify run on {{ $labels.host }} found sealed
            bundles of {{ $labels.client }} failing their zstd checksum, which means
            corruption at rest. `journalctl -t sfmix-backup-verify -p err` lists
            them. Check the VM's disks and pve01.scl04's tank pool.

      - alert: BackupVerifyStale
        expr: >
          (time() - sfmix_backup_verify_last_run_timestamp_seconds) > 8 * 86400
        for: 1h
        labels: {severity: warning, component: backups}
        annotations:
          dashboard: https://grafana.sfmix.org/d/sfmix-backups/backups?from=now-2d&to=now
          summary: "Backup verify on {{ $labels.host }} has not completed in 8 days"
          description: >-
            sfmix-backup-verify.timer (weekly) on {{ $labels.host }} is not
            completing. `systemctl status sfmix-backup-verify`.
{% endraw %}
