{#
  Long-term telemetry tier (design doc 012): Thanos sidecar + query on
  metrics.sfo02, store + compact + Garage on metrics01.scl04. Scrape label
  thanos_component says which piece; `component` stays the routing label.
#}
---
groups:
  - name: sfmix-thanos-alerts
    rules:
{% raw %}
      - alert: ThanosComponentDown
        expr: up{job=~"thanos|garage"} == 0
        for: 10m
        labels: {severity: warning, component: telemetry}
        annotations:
          summary: "{{ $labels.job }} {{ $labels.thanos_component }} on {{ $labels.host }} is not answering"
          description: >-
            Prometheus cannot scrape {{ $labels.job }}
            {{ $labels.thanos_component }} on {{ $labels.host }}. Sidecar/query
            down = dashboards fail (Grafana's Prometheus datasource is Thanos
            Query); store/Garage down = history older than 30d missing from
            graphs and uploads queue up. `docker ps -a` / `docker logs` on the
            host.

      # The sidecar retries forever; a failure counter that keeps climbing
      # means blocks are piling up locally and will eventually age out of the
      # 30d local retention unshipped.
      - alert: ThanosSidecarUploadFailing
        expr: increase(thanos_shipper_upload_failures_total[1h]) > 0
        for: 1h
        labels: {severity: warning, component: telemetry}
        annotations:
          summary: Thanos sidecar on {{ $labels.host }} failing to upload blocks
          description: >-
            Uploads to the bucket on metrics01.scl04 have been failing for an
            hour. Check Garage on metrics01.scl04 and the oob path from
            metrics.sfo02 (`docker logs --since 1h thanos-sidecar`).

      # A 2h block is cut every 2h, so >6h without an upload means shipping
      # has stopped even if nothing is counting failures.
      - alert: ThanosSidecarNotUploading
        expr: >
          time() - max by (host) (thanos_objstore_bucket_last_successful_upload_time{thanos_component="sidecar"}) > 6 * 3600
          and max by (host) (thanos_objstore_bucket_last_successful_upload_time{thanos_component="sidecar"}) > 0
        for: 30m
        labels: {severity: warning, component: telemetry}
        annotations:
          summary: No Thanos block shipped from {{ $labels.host }} in {{ $value | humanizeDuration }}
          description: >-
            The sidecar has not uploaded a block for over 6 hours.
            `docker logs --since 6h thanos-sidecar` on metrics.sfo02.

      # Halts on overlapping or corrupt blocks and stays halted until someone
      # looks: no compaction, no downsampling, no retention.
      - alert: ThanosCompactHalted
        expr: thanos_compact_halted == 1
        for: 5m
        labels: {severity: warning, component: telemetry}
        annotations:
          summary: Thanos compactor on {{ $labels.host }} has halted
          description: >-
            The compactor hit a block it refuses to process and stopped.
            Downsampling and bucket retention are paused until fixed.
            `docker logs thanos-compact` on metrics01.scl04 names the block
            (`thanos tools bucket mark --marker=no-compact-mark.json` to skip).

      # Iterations run every 5m; the first backfill can take hours, hence 6h.
      - alert: ThanosCompactNotRunning
        expr: increase(thanos_compact_iterations_total[6h]) == 0
        for: 30m
        labels: {severity: warning, component: telemetry}
        annotations:
          summary: Thanos compactor on {{ $labels.host }} has not completed a run in 6h
          description: >-
            No compaction iteration has finished in 6 hours. Downsampling and
            retention are falling behind. `docker logs --since 6h
            thanos-compact` on metrics01.scl04.

      # ── Bucket capacity (doc 012, "Bucket capacity") ──
      # A full Garage node does not degrade gracefully: with replication 2
      # writes stall, the sidecar can't ship, and the compactor (whose scratch
      # dir shares /srv/telemetry on scl04) can't compact -- so retention
      # stops too and nothing frees itself. Warn well before the node_exporter
      # 85% alert so there is room left to run the cleanup.
      - alert: GarageDiskLow
        expr: >
          100 * garage_local_disk_avail{volume="data"}
              / garage_local_disk_total{volume="data"} < 25
        for: 1h
        labels: {severity: warning, component: telemetry}
        annotations:
          summary: Garage data disk on {{ $labels.host }} is {{ printf "%.0f" $value }}% free
          description: >-
            The Thanos bucket's disk is under 25% free. In order: grow the
            zvol (`qm resize <vmid> scsi1 +NG`, `resize2fs`, raise
            metrics_archive_garage_capacity); shorten
            metrics_archive_thanos_retention_5m (1h already covers that
            span); last, mark the oldest 1h blocks with `thanos tools bucket
            mark --marker=deletion-mark.json`. Never delete objects in Garage
            directly or with S3 lifecycle rules.
          dashboard: https://grafana.sfmix.org/d/sfmix-longterm-metrics

      - alert: GarageDiskCritical
        expr: >
          100 * garage_local_disk_avail{volume="data"}
              / garage_local_disk_total{volume="data"} < 10
        for: 15m
        labels: {severity: critical, component: telemetry}
        annotations:
          summary: Garage data disk on {{ $labels.host }} is {{ printf "%.0f" $value }}% free
          description: >-
            Under 10% free: bucket writes are about to fail, and once they do
            the compactor can neither compact nor apply retention. Grow the
            disk now (see GarageDiskLow); deletion marks take effect only
            after the compactor's 48h delete-delay.
          dashboard: https://grafana.sfmix.org/d/sfmix-longterm-metrics

      # Long-range trend. Gated at 50% used so one-off bulk writes (a backfill
      # or a node resync) on a mostly-empty disk don't extrapolate to "full".
      - alert: GarageDiskFillingUp
        expr: >
          predict_linear(garage_local_disk_avail{volume="data"}[30d], 90 * 86400) < 0
          and 100 * (1 - garage_local_disk_avail{volume="data"}
                         / garage_local_disk_total{volume="data"}) > 50
        for: 1d
        labels: {severity: warning, component: telemetry}
        annotations:
          summary: Garage data disk on {{ $labels.host }} will be full within 90 days at the 30-day trend
          description: >-
            Over half full and trending to zero within a quarter. Expected
            steady state grows only ~5-15 GB/yr (the 1h tier), so a trend
            like this means series cardinality jumped or retention stopped
            (check ThanosCompactHalted / ThanosCompactNotRunning). Plan the
            disk growth or retention change from GarageDiskLow.
          dashboard: https://grafana.sfmix.org/d/sfmix-longterm-metrics

      # The 1h "forever" tier is never trimmed, so its growth rate is the
      # long-run budget. ~5-15 GB/yr is normal at ~133k series; 5 GB in 30
      # days means a cardinality blow-up is being written into it permanently.
      - alert: ThanosForeverTierGrowingFast
        expr: delta(thanos_bucket_size_bytes{resolution="1h"}[30d]) > 5e9
        for: 6h
        labels: {severity: info, component: telemetry}
        annotations:
          summary: Thanos 1h tier grew {{ $value | humanize1024 }}B in 30 days
          description: >-
            The never-expiring 1h tier is growing several times faster than
            planned. Find the high-cardinality job/metric
            (`topk(10, count by (__name__) ({__name__=~".+"}))` on Prometheus,
            or the TSDB status page) and fix it at the source; data already
            in the tier stays until blocks are marked for deletion.
          dashboard: https://grafana.sfmix.org/d/sfmix-longterm-metrics
{% endraw %}
