{{ ansible_managed | comment }}

rpc_url: "http://{{ looking_glass_rpc_bind }}"
rpc_secret_env: "LG_RPC_SECRET"

telnet:
  enabled: true
  bind:
{% for addr in looking_glass_bind_addresses %}
    - "{{ addr if ':' not in addr else '[' ~ addr ~ ']' }}:{{ looking_glass_telnet_port }}"
{% endfor %}

ssh:
  enabled: {{ looking_glass_ssh_enabled | lower }}
{% if looking_glass_ssh_enabled %}
  bind:
{% for addr in looking_glass_bind_addresses %}
    - "{{ addr if ':' not in addr else '[' ~ addr ~ ']' }}:{{ looking_glass_ssh_port }}"
{% endfor %}
  host_key: "{{ looking_glass_config_dir }}/ssh_host_ed25519_key"
{% if looking_glass_oidc_enabled %}
  ca_key: "{{ looking_glass_config_dir }}/ca_ed25519_key"
{% endif %}
{% endif %}

# Per-source fairness for telnet/SSH (sources grouped by /24 or /56) and
# disconnect after idle_timeout_secs without keystrokes (0 = never).
frontend_limits:
  idle_timeout_secs: {{ looking_glass_cli_idle_timeout_secs }}
  max_connections: {{ looking_glass_cli_max_connections }}
  max_connections_per_source: {{ looking_glass_cli_max_connections_per_source }}

{% if looking_glass_oidc_enabled %}
auth:
  oidc:
    issuer: "{{ looking_glass_oidc_issuer }}"
    client_id: "{{ looking_glass_oidc_client_id }}"
    device_auth_endpoint: "{{ looking_glass_oidc_device_auth_endpoint }}"
    token_endpoint: "{{ looking_glass_oidc_token_endpoint }}"
    jwks_uri: "{{ looking_glass_oidc_jwks_uri }}"
    group_prefix: "{{ looking_glass_oidc_group_prefix }}"
    admin_group: "{{ looking_glass_oidc_admin_group }}"
    cert_lifetime_secs: {{ looking_glass_oidc_cert_lifetime_secs }}
{% endif %}
