# Managed by Ansible (roles/metrics_archive). Garage cluster holding the
# Thanos bucket: one node per site (zone), every object on every node.
# replication_factor and rpc_secret MUST match on all nodes.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
# sqlite survives unclean shutdowns better than the lmdb default.
db_engine = "sqlite"
replication_factor = {{ metrics_archive_garage_replication_factor }}

rpc_bind_addr = "[::]:3901"
# Address the other nodes dial (management network).
rpc_public_addr = "{{ ansible_host }}:3901"
rpc_secret = "{{ garage_rpc_secret }}"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"

[admin]
api_bind_addr = "[::]:{{ garage_admin_port }}"
admin_token = "{{ garage_admin_token }}"
metrics_token = "{{ garage_metrics_token }}"
