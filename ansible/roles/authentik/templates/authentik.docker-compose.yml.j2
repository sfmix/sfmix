---
services:
  postgresql:
    image: docker.io/library/postgres:16-alpine
    restart: unless-stopped
    # The stock image runs with max_connections=100. authentik's Django opens a
    # connection per concurrent request rather than pooling, so concurrency --
    # not request volume -- is what consumes the budget, and on 2026-09-21 a
    # single bot walking the login chain ran all 100 dry: Postgres returned
    # "sorry, too many clients already" and portal SSO logins 500ed for ~12
    # minutes. The nginx limits in authentik-limits.conf.j2 now cap concurrency
    # per client, and this raises the ceiling those limits sit under.
    #
    # Not set higher because this host has ~4G of RAM: each backend costs a few
    # MB of private memory on top of shared_buffers, so the ceiling has to stay
    # somewhere the box can actually honour it.
    #
    # The way past this is pooling, and authentik already ships one -- its
    # default.yml carries `postgresql: {conn_max_age: 0, use_pool: False}`, so
    # AUTHENTIK_POSTGRESQL__USE_POOL / __CONN_MAX_AGE are the knobs. Not
    # PgBouncer: the app and its database share this one host, so a second
    # daemon would buy nothing the built-in pool does not. Enabling it changes
    # connection lifecycle (and wants a look at how authentik's psycopg
    # prepared statements behave), so it is a deliberate change with a quiet
    # window, not a default to flip here.
    #
    # Note that AUTHENTIK_WEB__WORKERS/__THREADS do NOT bound this: 2026.x
    # serves requests async, so each awaited query lands in Django's
    # async-to-sync executor. That is how a 1-worker/2-thread server opened
    # ~100 connections during the incident above.
    command:
      - postgres
      - -c
      - max_connections={{ authentik_postgres_max_connections }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 5s
    volumes:
      - /opt/authentik/database:/var/lib/postgresql/data
    environment:
      POSTGRES_PASSWORD: ${PG_PASS:?database password required}
      POSTGRES_USER: ${PG_USER:-authentik}
      POSTGRES_DB: ${PG_DB:-authentik}
    env_file:
      - .env
  redis:
    image: docker.io/library/redis:alpine
    command: --save 60 1 --loglevel warning
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      start_period: 20s
      interval: 30s
      retries: 5
      timeout: 3s
    volumes:
      - /opt/authentik/redis:/data
  server:
    image: ${AUTHENTIK_IMAGE:-ghcr.io/goauthentik/server}:${AUTHENTIK_TAG:-2024.2.2}
    restart: unless-stopped
    command: server
    environment:
      AUTHENTIK_REDIS__HOST: redis
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: ${PG_USER:-authentik}
      AUTHENTIK_POSTGRESQL__NAME: ${PG_DB:-authentik}
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
    volumes:
      - /opt/authentik/media:/media
      - /opt/authentik/custom-templates:/templates
    env_file:
      - .env
    ports:
      - "127.0.0.1:9000:9000"
      - "127.0.0.1:9443:9443"
    depends_on:
      - postgresql
      - redis
  worker:
    image: ${AUTHENTIK_IMAGE:-ghcr.io/goauthentik/server}:${AUTHENTIK_TAG:-2024.2.2}
    restart: unless-stopped
    command: worker
    environment:
      AUTHENTIK_REDIS__HOST: redis
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: ${PG_USER:-authentik}
      AUTHENTIK_POSTGRESQL__NAME: ${PG_DB:-authentik}
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
    # NOTE: upstream ships this worker with `user: root` and a docker.sock mount
    # for the optional Docker outpost controller. Both are removed/disabled here:
    #   - `user: root` only exists to chown the mounted folders at startup, but the
    #     ansible role already pre-creates media/certs/templates owned 999:1000, so
    #     it serves no purpose and needlessly runs the worker as root.
    #   - the docker.sock mount below is only needed by authentik's embedded Docker
    #     outpost controller (https://goauthentik.io/docs/outposts/integrations/docker),
    #     which SFMIX does not use. Mounting it grants the worker root-equivalent
    #     control of the host (a container-escape path), so it stays disabled.
    #     When outposts are introduced, deploy them as manually-managed containers
    #     via ansible rather than re-enabling this socket.
    volumes:
      # - /var/run/docker.sock:/var/run/docker.sock
      - /opt/authentik/media:/media
      - /opt/authentik/certs:/certs
      - /opt/authentik/custom-templates:/templates
    env_file:
      - .env
    depends_on:
      - postgresql
      - redis
