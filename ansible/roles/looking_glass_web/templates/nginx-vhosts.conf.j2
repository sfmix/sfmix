{{ ansible_managed | comment }}

# HTTP to HTTPS redirect (certbot's standalone issuance stops nginx first).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

{% if looking_glass_web_redirect_domains %}
# Aliases: one canonical name so the OAuth resource lg-http advertises (from
# the Host header) always matches what MCP clients configured. 308 keeps the
# method, so a POST /mcp through an alias follows cleanly.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ looking_glass_web_redirect_domains | join(' ') }};

    ssl_certificate /etc/letsencrypt/live/{{ looking_glass_web_domains[0] }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ looking_glass_web_domains[0] }}/privkey.pem;
    ssl_dhparam /etc/ssl/certs/dhparam.pem;

    return 308 https://{{ looking_glass_web_canonical_domain }}$request_uri;
}

{% endif %}
# Looking glass front door: {{ looking_glass_web_domains | difference(looking_glass_web_redirect_domains) | join(' ') }}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ looking_glass_web_domains | difference(looking_glass_web_redirect_domains) | join(' ') }};

    ssl_certificate /etc/letsencrypt/live/{{ looking_glass_web_domains[0] }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ looking_glass_web_domains[0] }}/privkey.pem;
    ssl_dhparam /etc/ssl/certs/dhparam.pem;

    # Per-source-prefix (/24, /56) fairness: lg_ip caps request rate, lg_conn caps concurrent
    # requests (slow CGI traceroutes, long-lived MCP streams). Exempt admin
    # subnets have an empty key and are never counted. 429 = "slow down",
    # not nginx's default 503 "broken".
    limit_conn lg_conn {{ looking_glass_web_conn_limit_per_source }};
    limit_req_status 429;
    limit_conn_status 429;

    # Live tools, not content worth indexing.
    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\n{% for path in looking_glass_web_robots_disallow %}Disallow: {{ path }}\n{% endfor %}";
    }

    # Artefacts published by Ansible (participants_json role, arouteserver
    # summary pages). Consumed by sfmix.org/participants/, sflow-rt, scripts.
    location ~ ^/(participants(\.min)?\.json|participants_table\.json|[^/]+\.summary\.html)$ {
        root {{ looking_glass_web_static_directory }};
        add_header Cache-Control "public, max-age=300";
    }

    # lg-ng REST API. Longest ^~ prefix wins, so this takes precedence over the
    # legacy /api/ proxy below.
    location ^~ /api/v1/ {
        limit_req zone=lg_ip burst={{ looking_glass_web_rate_limit_burst }} nodelay;
        proxy_pass {{ looking_glass_web_lg_http_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout {{ looking_glass_web_proxy_connect_timeout }};
        proxy_read_timeout {{ looking_glass_web_proxy_read_timeout }};
    }

    # lg-ng MCP (SSE): no buffering, long read timeout, HTTP/1.1 keepalive.
    location ^~ /mcp {
        limit_req zone=lg_ip burst={{ looking_glass_web_rate_limit_burst }} nodelay;
        limit_conn lg_conn {{ looking_glass_web_mcp_conn_limit_per_source }};
        proxy_pass {{ looking_glass_web_lg_http_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_connect_timeout {{ looking_glass_web_proxy_connect_timeout }};
        proxy_read_timeout {{ looking_glass_web_mcp_read_timeout }};
    }

    # Legacy OpenBGPD looking glass on the route collector, over the mgmt
    # network: bgplgd JSON API (/api/neighbors, ...; Alice's source and the
    # route_server_parity script) and the bgplg CGI (bgplg header logo at
    # /sfmix.png). The collector itself has no public address.
    location ^~ /api/ {
        limit_req zone=lg_ip burst={{ looking_glass_web_rate_limit_burst }} nodelay;
        proxy_pass {{ looking_glass_web_collector_url }}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout {{ looking_glass_web_proxy_connect_timeout }};
        proxy_read_timeout {{ looking_glass_web_proxy_read_timeout }};
    }
    location ^~ /cgi-bin/ {
        limit_req zone=lg_ip burst={{ looking_glass_web_rate_limit_burst }} nodelay;
        proxy_pass {{ looking_glass_web_collector_url }}/cgi-bin/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout {{ looking_glass_web_proxy_connect_timeout }};
        # ping/traceroute from bgplg take a while.
        proxy_read_timeout 120s;
    }
    location = /sfmix.png {
        proxy_pass {{ looking_glass_web_collector_url }}/sfmix.png;
        add_header Cache-Control "public, max-age=86400";
    }

    # The summary page (role files/index.html) and its fonts/logo. The page
    # reads /api/summary, /api/memory, /api/neighbors and /api/v1/participants
    # from this same origin.
    location = / {
        root {{ looking_glass_web_static_directory }};
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }
    location /assets/ {
        root {{ looking_glass_web_static_directory }};
        add_header Cache-Control "public, max-age=604800";
    }

    # Everything else is lg-http.
    location / {
        limit_req zone=lg_ip burst={{ looking_glass_web_rate_limit_burst }} nodelay;
        proxy_pass {{ looking_glass_web_lg_http_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout {{ looking_glass_web_proxy_connect_timeout }};
        proxy_read_timeout {{ looking_glass_web_proxy_read_timeout }};
    }
}
