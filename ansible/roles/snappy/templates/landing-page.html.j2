<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Test your network speed to the San Francisco Metropolitan Internet eXchange (SFMIX). LibreSpeed, OpenSpeedTest, iperf3, and TR-143 endpoints available.">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="SFMIX Snappy Speed Test">
    <meta property="og:description" content="Test your network speed to the San Francisco Metropolitan Internet eXchange. Multiple speed test tools available.">
    <meta property="og:url" content="https://{{ snappy_speedtest_domain }}/">
    <meta property="og:site_name" content="SFMIX">
    <meta property="og:image" content="https://{{ snappy_speedtest_domain }}/static/sfmix-fiber-spray.png">
    <meta property="og:image:width" content="1024">
    <meta property="og:image:height" content="512">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="SFMIX Snappy Speed Test">
    <meta name="twitter:description" content="Test your network speed to the San Francisco Metropolitan Internet eXchange. Multiple speed test tools available.">
    <meta name="twitter:image" content="https://{{ snappy_speedtest_domain }}/static/sfmix-fiber-spray.png">

    <title>SFMIX Snappy - Speed Test</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: #0d1117;
            color: #e0e0e0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Animated rainbow top bar */
        .rainbow-bar {
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg,
                #ff0000, #ff7700, #ffdd00, #00cc44, #0088ff, #8800ff, #ff0000);
            background-size: 200% 100%;
            animation: slide 3s linear infinite;
        }
        @keyframes slide { to { background-position: 200% 0; } }

        /* Hero banner: dusk sky, fiber-optic light pulses, and a San Francisco skyline */
        .hero {
            width: 100%;
            height: 220px;
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(ellipse 60% 55% at 53% 100%, rgba(255, 150, 90, 0.16), transparent 70%),
                linear-gradient(180deg, #0d1117 0%, #10172a 45%, #171c36 80%, #221f38 100%);
        }

        .fiber {
            position: absolute;
            height: 3px;
            border-radius: 3px;
            filter: blur(1px);
            opacity: 0;
            animation: shoot 3s ease-in-out infinite;
        }
        .fiber::after {
            content: '';
            position: absolute;
            right: 0;
            top: -3px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: inherit;
            filter: blur(3px);
        }

        /* Fibers stream through the sky above the skyline (which is opaque from ~70% down) */
        .fiber:nth-child(1)  { top: 6%;   background: #ff4444; width: 0; left: -5%;  animation-delay: 0.0s; animation-duration: 2.8s; }
        .fiber:nth-child(2)  { top: 12%;  background: #ff8800; width: 0; left: -8%;  animation-delay: 0.3s; animation-duration: 3.2s; }
        .fiber:nth-child(3)  { top: 20%;  background: #ffdd00; width: 0; left: -3%;  animation-delay: 0.7s; animation-duration: 2.5s; }
        .fiber:nth-child(4)  { top: 27%;  background: #00cc44; width: 0; left: -10%; animation-delay: 0.1s; animation-duration: 3.0s; }
        .fiber:nth-child(5)  { top: 34%;  background: #0088ff; width: 0; left: -6%;  animation-delay: 0.5s; animation-duration: 2.7s; }
        .fiber:nth-child(6)  { top: 41%;  background: #8844ff; width: 0; left: -2%;  animation-delay: 0.9s; animation-duration: 3.4s; }
        .fiber:nth-child(7)  { top: 48%;  background: #ff44aa; width: 0; left: -7%;  animation-delay: 0.4s; animation-duration: 2.6s; }
        .fiber:nth-child(8)  { top: 16%;  background: #44ddff; width: 0; left: -4%;  animation-delay: 1.1s; animation-duration: 3.1s; }
        .fiber:nth-child(9)  { top: 24%;  background: #ff6644; width: 0; left: -9%;  animation-delay: 0.6s; animation-duration: 2.9s; }
        .fiber:nth-child(10) { top: 38%;  background: #88ff44; width: 0; left: -1%;  animation-delay: 1.3s; animation-duration: 3.3s; }

        @keyframes shoot {
            0%   { width: 0;    opacity: 0; }
            10%  { opacity: 0.9; }
            50%  { width: 110%; opacity: 0.7; }
            80%  { opacity: 0.3; }
            100% { width: 110%; opacity: 0; }
        }

        /* SF skyline: Golden Gate, Sutro, downtown, Bay Bridge, drawn at true scale.
           The SVG is 2400x220 with xMidYMax slice, so it never distorts: wide viewports
           see more of the Bay, narrow ones crop to downtown. */
        .skyline {
            position: absolute;
            inset: 0;
        }
        .skyline svg { display: block; width: 100%; height: 100%; }

        @media (prefers-reduced-motion: reduce) {
            .rainbow-bar, .fiber { animation: none; }
            .fiber { display: none; }
        }

        .container {
            max-width: 720px;
            width: 100%;
            padding: 40px 24px;
        }

        header {
            text-align: center;
            margin-bottom: 40px;
        }

        h1 {
            font-size: 2.4em;
            font-weight: 700;
            background: linear-gradient(90deg, #ff6b6b, #ffa94d, #ffd43b, #69db7c, #4dabf7, #b197fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 8px;
        }

        .subtitle {
            font-size: 1.05em;
            color: #6b7b8d;
            letter-spacing: 0.5px;
        }

        .card-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 28px 24px;
            text-decoration: none;
            color: #e0e0e0;
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            border-radius: 16px 16px 0 0;
            opacity: 0.8;
        }

        .card-librespeed::before { background: linear-gradient(90deg, #ff6b6b, #ffa94d); }
        .card-openspeedtest::before { background: linear-gradient(90deg, #4dabf7, #69db7c); }

        .card:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        }

        .card .icon { font-size: 2em; margin-bottom: 12px; }
        .card h2 { font-size: 1.15em; margin-bottom: 6px; color: #fff; }
        .card p { font-size: 0.85em; color: #6b7b8d; line-height: 1.5; }

        .cli-section {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 40px;
        }

        .cli-section h2 {
            font-size: 0.8em;
            color: #6b7b8d;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 600;
        }

        .cli-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
        }

        .cli-item + .cli-item {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .cli-item .label {
            font-weight: 600;
            color: #b197fc;
            min-width: 72px;
            font-size: 0.9em;
        }

        .cli-item code {
            background: rgba(0, 0, 0, 0.4);
            padding: 5px 10px;
            border-radius: 6px;
            font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
            font-size: 0.82em;
            color: #69db7c;
            word-break: break-all;
        }

        footer {
            text-align: center;
            color: #3d4550;
            font-size: 0.82em;
            padding-bottom: 32px;
        }

        footer a { color: #4dabf7; text-decoration: none; }
        footer a:hover { text-decoration: underline; }

        @media (max-width: 600px) {
            .card-grid { grid-template-columns: 1fr; }
            h1 { font-size: 1.6em; }
            .hero { height: 150px; }
            .cli-item { flex-direction: column; align-items: flex-start; gap: 4px; }
        }
    </style>
</head>
