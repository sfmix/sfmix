  // Honor prefers-reduced-motion for the SMIL skyline animations (CSS can't reach them).
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var sky = document.querySelector('.skyline svg');
    if (sky && sky.pauseAnimations) { sky.pauseAnimations(); }
  }

  // ---- Language: ?lang=, else the shared sfmix-lang cookie (also written by
  // sfmix.org's and lg.sfmix.org's pickers), else the browser's first of en/es/de.
  // Novelty locales are only ever an explicit pick, as on sfmix.org.
  var byCode = {}; LANGS.forEach(function (l) { byCode[l.code] = l; });
  var lang = 'en', dict = {};
  function norm(s) { return s.replace(/\s+/g, ' ').trim(); }
  function t(key) { return Object.prototype.hasOwnProperty.call(dict, key) ? dict[key] : key; }
  function readLangCookie() { var m = document.cookie.match(/(?:^|;\s*)sfmix-lang=([a-z]+)(?:;|$)/); return m && byCode[m[1]] ? m[1] : null; }
  function saveLang(l) {
    var dom = /(^|\.)sfmix\.org$/.test(location.hostname) ? '; domain=sfmix.org' : '';
    document.cookie = 'sfmix-lang=' + l + dom + '; path=/; max-age=31536000; samesite=lax' + (location.protocol === 'https:' ? '; secure' : '');
  }
  function pickLang() {
    var q = null; try { q = new URLSearchParams(location.search).get('lang'); } catch (e) {}
    if (q && byCode[q]) return q;
    var c = readLangCookie(); if (c) return c;
    var prefs = navigator.languages || [navigator.language || 'en'];
    for (var i = 0; i < prefs.length; i++) { var b = String(prefs[i]).toLowerCase().split('-')[0]; if (b === 'en' || b === 'es' || b === 'de') return b; }
    return 'en';
  }
  // Remember each element's English source once, then translate in place.
  var textEls = [], attrEls = [];
  document.querySelectorAll('[data-t]').forEach(function (el) { textEls.push([el, norm(el.textContent)]); });
  document.querySelectorAll('[data-t-attr]').forEach(function (el) {
    var orig = {}; el.dataset.tAttr.split(' ').forEach(function (a) { orig[a] = el.getAttribute(a); }); attrEls.push([el, orig]);
  });
  var menu = $('#lang-menu');
  menu.innerHTML = LANGS.map(function (l) { return '<li><a href="/?lang=' + l.code + '" class="dropdown-link" data-lang="' + l.code + '" hreflang="' + l.tag + '">' + l.name + '</a></li>'; }).join('');
  function applyLang(code) {
    lang = byCode[code] ? code : 'en';
    var L = byCode[lang];
    dict = I18N[lang] || {};
    html.lang = L.tag;
    textEls.forEach(function (p) { p[0].textContent = t(p[1]); });
    attrEls.forEach(function (p) { Object.keys(p[1]).forEach(function (a) { p[0].setAttribute(a, t(p[1][a])); }); });
    document.querySelectorAll('[data-sfmix]').forEach(function (a) { a.href = 'https://sfmix.org' + L.path + a.dataset.sfmix; });
    $('#lang-current').textContent = L.name;
    menu.querySelectorAll('a').forEach(function (a) { a.classList.toggle('is-active', a.dataset.lang === lang); });
    document.title = t('Snappy Speed Test') + ' | SFMIX';
  }
  menu.addEventListener('click', function (e) {
    var a = e.target.closest('a[data-lang]'); if (!a) return;
    e.preventDefault();
    try { saveLang(a.dataset.lang); } catch (err) {}
    try { history.replaceState(null, '', location.pathname + location.hash); } catch (err) {}
    closeAll();
    applyLang(a.dataset.lang);
  });

  // ---- Theme toggle, shared cookie with every *.sfmix.org site (see <head>).
  var meta = document.querySelector('meta[name="theme-color"]');
  function systemTheme() { try { return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; } catch (e) { return 'light'; } }
  function currentTheme() { return html.getAttribute('data-theme') || systemTheme(); }
  function reflect() { var d = currentTheme() === 'dark'; if (meta) meta.setAttribute('content', d ? '#071f26' : '#0b3640'); $('.theme-toggle__btn').setAttribute('aria-pressed', d ? 'true' : 'false'); }
  $('.theme-toggle__btn').addEventListener('click', function (e) { e.stopPropagation(); var n = currentTheme() === 'dark' ? 'light' : 'dark'; html.setAttribute('data-theme', n); try { window.sfmixSaveTheme(n); } catch (err) {} reflect(); });
  // Theme or language may have changed on another *.sfmix.org site meanwhile.
  function resync() {
    var th = null; try { th = window.sfmixReadTheme(); } catch (e) {}
    if (th && th !== html.getAttribute('data-theme')) { html.setAttribute('data-theme', th); reflect(); }
    var l = readLangCookie(); if (l && l !== lang && !/[?&]lang=/.test(location.search)) applyLang(l);
  }
  document.addEventListener('visibilitychange', function () { if (!document.hidden) resync(); });
  window.addEventListener('pageshow', function (e) { if (e.persisted) resync(); });
  try { var mq = matchMedia('(prefers-color-scheme: dark)'); var onMq = function () { if (!html.getAttribute('data-theme')) reflect(); }; if (mq.addEventListener) mq.addEventListener('change', onMq); else if (mq.addListener) mq.addListener(onMq); } catch (e) {}
  reflect();

  // ---- Nav: the same behaviour as sfmix.org (hamburger, click-to-open dropdowns, Escape/arrow keys).
  var toggle = $('.nav-toggle'), nav = $('#site-nav');
  toggle.addEventListener('click', function () { var ex = this.getAttribute('aria-expanded') === 'true'; this.setAttribute('aria-expanded', !ex); nav.classList.toggle('open'); });
  function closeAll() { document.querySelectorAll('.dropdown-toggle').forEach(function (b) { b.setAttribute('aria-expanded', 'false'); b.parentElement.classList.remove('dropdown-open'); }); }
  document.querySelectorAll('.dropdown-toggle').forEach(function (btn) {
    btn.addEventListener('click', function (e) { e.stopPropagation(); var ex = this.getAttribute('aria-expanded') === 'true'; closeAll(); if (!ex) { this.setAttribute('aria-expanded', 'true'); this.parentElement.classList.add('dropdown-open'); } });
  });
  document.addEventListener('click', closeAll);
  document.querySelectorAll('.has-dropdown').forEach(function (item) {
    var btn = item.querySelector('.dropdown-toggle'), links;
    item.addEventListener('keydown', function (e) {
      links = item.querySelectorAll('.dropdown-link');
      var idx = Array.prototype.indexOf.call(links, document.activeElement);
      if (e.key === 'Escape') { btn.setAttribute('aria-expanded', 'false'); item.classList.remove('dropdown-open'); btn.focus(); }
      if (e.key === 'ArrowDown') { e.preventDefault(); if (idx < links.length - 1) links[idx + 1].focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); if (idx > 0) links[idx - 1].focus(); else if (idx === 0) btn.focus(); }
    });
    item.addEventListener('focusout', function () { setTimeout(function () { if (!item.contains(document.activeElement)) { btn.setAttribute('aria-expanded', 'false'); item.classList.remove('dropdown-open'); } }, 0); });
  });

  applyLang(pickLang());
})();
</script>
