    <div class="container">
        <div class="intro">
            <h1 data-t>Snappy Speed Test</h1>
            <p class="lede" data-t>Measure throughput and latency between your network and SFMIX, in your browser or from the command line.</p>
        </div>

        <div class="content">
            <section>
                <h2 data-t>In your browser</h2>
                <div class="card-grid">
                    <a href="/librespeed/" class="card card-librespeed">
                        <div class="icon" aria-hidden="true">&#9889;</div>
                        <h3>LibreSpeed</h3>
                        <p data-t>Rust-powered speed test with ping, jitter, download &amp; upload measurements.</p>
                        <span class="go" data-t>Start the test</span>
                    </a>
                    <a href="/openspeedtest/" class="card card-openspeedtest">
                        <div class="icon" aria-hidden="true">&#127760;</div>
                        <h3>OpenSpeedTest</h3>
                        <p data-t>HTML5-based network performance test. No Flash, no Java, no plugins.</p>
                        <span class="go" data-t>Start the test</span>
                    </a>
                </div>
            </section>

            <section>
                <h2 data-t>Command line and TR-143</h2>
                <div class="cli">
                    <div class="cli-item">
                        <span class="label"><a href="https://github.com/esnet/iperf">iperf3</a></span>
                        <div>
                            <code>iperf3 -c {{ snappy_speedtest_domain }}</code>
                            <div class="desc" data-t>The standard network throughput measurement tool. Single-client TCP/UDP testing.</div>
                        </div>
                    </div>
                    <div class="cli-item">
                        <span class="label"><a href="https://github.com/lance0/xfr">xfr</a></span>
                        <div>
                            <code>xfr {{ snappy_speedtest_domain }} -p {{ xfr_port }}</code>
                            <div class="desc" data-t>Modern iperf3 alternative with multi-client server, QUIC support, and live TUI. Built in Rust.</div>
                        </div>
                    </div>
                    <div class="cli-item">
                        <span class="label"><a href="https://github.com/jof/btest-rs">btest</a></span>
                        <div>
                            <code>/tool bandwidth-test {{ snappy_speedtest_domain }} protocol=tcp</code>
                            <div class="desc" data-t>MikroTik bandwidth-test server. Supports TCP and UDP modes with multi-connection testing.</div>
                        </div>
                    </div>
                    <div class="cli-item">
                        <span class="label">TR-143</span>
                        <div>
                            <code>https://{{ snappy_speedtest_domain }}/tauc/downloads/20MB.file</code>
                            <div class="desc" data-t>HTTP download test file (20 MB) for TR-143 and TAUC testing.</div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</main>

