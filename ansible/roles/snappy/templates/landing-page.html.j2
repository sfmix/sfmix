<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Test your network speed to the San Francisco Metropolitan Internet eXchange (SFMIX). LibreSpeed, OpenSpeedTest, iperf3, and TR-143 endpoints available.">
    <meta name="theme-color" content="#0b3640">
    <meta name="color-scheme" content="light dark">
    <link rel="icon" href="/static/favicon-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="SFMIX Snappy Speed Test">
    <meta property="og:description" content="Test your network speed to the San Francisco Metropolitan Internet eXchange. Multiple speed test tools available.">
    <meta property="og:url" content="https://{{ snappy_speedtest_domain }}/">
    <meta property="og:site_name" content="SFMIX">
    <meta property="og:image" content="https://{{ snappy_speedtest_domain }}/static/sfmix-fiber-spray.png">
    <meta property="og:image:width" content="1024">
    <meta property="og:image:height" content="512">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="SFMIX Snappy Speed Test">
    <meta name="twitter:description" content="Test your network speed to the San Francisco Metropolitan Internet eXchange. Multiple speed test tools available.">
    <meta name="twitter:image" content="https://{{ snappy_speedtest_domain }}/static/sfmix-fiber-spray.png">

    <title>Snappy Speed Test | SFMIX</title>
{% raw %}
<script>
  // Same contract as sfmix.org, lg., portal. and ip.: one explicit pick shared by every
  // *.sfmix.org site through the "sfmix-theme" cookie on Domain=sfmix.org, else the OS setting.
  window.sfmixReadTheme = function () {
    var m = document.cookie.match(/(?:^|;\s*)sfmix-theme=(dark|light)(?:;|$)/);
    return m ? m[1] : null;
  };
  window.sfmixSaveTheme = function (t) {
    var dom = /(^|\.)sfmix\.org$/.test(location.hostname) ? '; domain=sfmix.org' : '';
    document.cookie = 'sfmix-theme=' + t + dom + '; path=/; max-age=31536000; samesite=lax' + (location.protocol === 'https:' ? '; secure' : '');
  };
  try { var t = window.sfmixReadTheme(); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
</script>
<style>
@font-face { font-family: 'Inter'; font-style: normal; font-weight: 300 700; font-display: swap; src: url('/static/inter-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
@font-face { font-family: 'Inter'; font-style: normal; font-weight: 300 700; font-display: swap; src: url('/static/inter-latin-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* Brand tokens, header, nav and footer are copied from website/static/css/style.css
   (via ansible/roles/looking_glass_web/files/index.html) so snappy.sfmix.org reads as
   part of sfmix.org. Change them there first, then mirror here. */
:root {
  --color-primary: #0b3640;
  --color-primary-light: #1a6070;
  --color-accent: #e8913a;
  --color-hero-dark: #071f26;
  --color-bg: #ffffff;
  --color-bg-alt: #f5f7fa;
  --color-surface: #ffffff;
  --color-text: #222222;
  --color-text-light: #666666;
  --color-border: #dee2e6;
  --color-white: #ffffff;
  --color-heading: var(--color-primary);
  --color-link: var(--color-primary-light);
  --color-header-bg: var(--color-primary);
  --color-code-bg: rgba(0,0,0,0.04);
  --color-shadow: rgba(0,0,0,0.12);
  color-scheme: light;
  --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, "SF Mono", "Cascadia Code", Consolas, "Courier New", monospace;
  --container-width: 1100px;
  --header-height: 64px;
}
:root[data-theme="dark"] {
  --color-bg: #0f1a1e; --color-bg-alt: #14232a; --color-surface: #172a31;
  --color-text: #e4e9ec; --color-text-light: #9fb0b8; --color-border: #2a3f48;
  --color-heading: #cfe6ee; --color-link: #6fbcd0; --color-header-bg: #071f26;
  --color-code-bg: rgba(255,255,255,0.08); --color-shadow: rgba(0,0,0,0.5);
  color-scheme: dark;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --color-bg: #0f1a1e; --color-bg-alt: #14232a; --color-surface: #172a31;
    --color-text: #e4e9ec; --color-text-light: #9fb0b8; --color-border: #2a3f48;
    --color-heading: #cfe6ee; --color-link: #6fbcd0; --color-header-bg: #071f26;
    --color-code-bg: rgba(255,255,255,0.08); --color-shadow: rgba(0,0,0,0.5);
    color-scheme: dark;
  }
}

html { font-size: 16px; }
body { font-family: var(--font-sans); color: var(--color-text); background: var(--color-bg); line-height: 1.6; min-height: 100vh; display: flex; flex-direction: column; }
main { flex: 1; }
a { color: var(--color-link); text-decoration: none; }
a:hover { color: var(--color-accent); text-decoration: underline; }
:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
code { font-family: var(--font-mono); font-size: 0.9em; background: var(--color-code-bg); padding: 0.15em 0.45em; border-radius: 4px; }
.container { max-width: var(--container-width); margin: 0 auto; padding: 0 1.5rem; }
.skip-link { position: absolute; top: -100%; left: 1rem; z-index: 1000; padding: 0.5rem 1rem; background: var(--color-surface); color: var(--color-heading); font-weight: 600; border-radius: 0 0 4px 4px; }
.skip-link:focus { top: 0; text-decoration: none; }

/* ===== Header / Nav (sfmix.org) ===== */
.site-header { background: var(--color-header-bg); color: var(--color-white); position: sticky; top: 0; z-index: 100; height: var(--header-height); box-shadow: 0 2px 8px var(--color-shadow); }
.nav-container { display: flex; align-items: center; justify-content: space-between; height: var(--header-height); }
.site-logo { display: flex; align-items: center; flex-shrink: 0; }
.logo-img { height: 40px; width: auto; flex-shrink: 0; }
.nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: 0.5rem; flex-direction: column; gap: 5px; }
.nav-toggle span { display: block; width: 24px; height: 2px; background: var(--color-white); transition: 0.2s; }
.nav-list { display: flex; list-style: none; align-items: center; }
.nav-item { position: relative; }
.nav-link { display: inline-flex; align-items: center; height: var(--header-height); padding: 0 0.75rem; color: rgba(255,255,255,0.9); background: none; border: none; font: inherit; font-size: 0.9rem; line-height: 1; cursor: pointer; white-space: nowrap; text-decoration: none; -webkit-appearance: none; appearance: none; }
.nav-link:hover { color: var(--color-white); background: rgba(255,255,255,0.06); text-decoration: none; box-shadow: inset 0 -2px 0 var(--color-accent); }
.nav-link[aria-current="page"] { color: var(--color-white); box-shadow: inset 0 -2px 0 var(--color-accent); }
.dropdown-open > .nav-link { color: var(--color-white); background: rgba(255,255,255,0.10); box-shadow: inset 0 -2px 0 var(--color-accent); }
.dropdown-toggle::after { content: "▾"; font-size: 1.3em; margin-left: 0.4em; }
.dropdown-menu { display: none; position: absolute; top: 100%; left: 0; background: var(--color-surface); min-width: 200px; box-shadow: 0 4px 16px var(--color-shadow); border-radius: 0 0 6px 6px; list-style: none; z-index: 200; }
.dropdown-open > .dropdown-menu { display: block; }
.dropdown-link { display: block; padding: 0.6rem 1rem; color: var(--color-text); font-size: 0.9rem; }
.dropdown-link:hover { background: var(--color-bg-alt); color: var(--color-heading); text-decoration: none; }
.dropdown-link[aria-current="page"], .dropdown-link.is-active { font-weight: 600; }
.nav-item.is-current > .nav-link { color: var(--color-white); box-shadow: inset 0 -2px 0 var(--color-accent); }
.theme-toggle .nav-link { padding: 0 0.7rem; }
.theme-toggle svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.theme-toggle__label { display: none; margin-left: 0.5rem; }
.theme-toggle .icon-sun { display: none; }
:root[data-theme="dark"] .theme-toggle .icon-sun { display: block; }
:root[data-theme="dark"] .theme-toggle .icon-moon { display: none; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .theme-toggle .icon-sun { display: block; }
  :root:not([data-theme="light"]) .theme-toggle .icon-moon { display: none; }
}

/* ===== Snappy hero: dusk sky, fiber-optic light pulses and a San Francisco skyline.
   A night scene, so it stays dark in both themes. ===== */
.rainbow-bar {
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #ff0000, #ff7700, #ffdd00, #00cc44, #0088ff, #8800ff, #ff0000);
    background-size: 200% 100%;
    animation: slide 3s linear infinite;
}
@keyframes slide { to { background-position: 200% 0; } }
.hero {
    width: 100%;
    height: 220px;
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(ellipse 60% 55% at 53% 100%, rgba(255, 150, 90, 0.16), transparent 70%),
        linear-gradient(180deg, #0d1117 0%, #10172a 45%, #171c36 80%, #221f38 100%);
}
.fiber { position: absolute; height: 3px; border-radius: 3px; filter: blur(1px); opacity: 0; animation: shoot 3s ease-in-out infinite; }
.fiber::after { content: ''; position: absolute; right: 0; top: -3px; width: 8px; height: 8px; border-radius: 50%; background: inherit; filter: blur(3px); }
/* Fibers stream through the sky above the skyline (which is opaque from ~70% down) */
.fiber:nth-child(1)  { top: 6%;   background: #ff4444; width: 0; left: -5%;  animation-delay: 0.0s; animation-duration: 2.8s; }
.fiber:nth-child(2)  { top: 12%;  background: #ff8800; width: 0; left: -8%;  animation-delay: 0.3s; animation-duration: 3.2s; }
.fiber:nth-child(3)  { top: 20%;  background: #ffdd00; width: 0; left: -3%;  animation-delay: 0.7s; animation-duration: 2.5s; }
.fiber:nth-child(4)  { top: 27%;  background: #00cc44; width: 0; left: -10%; animation-delay: 0.1s; animation-duration: 3.0s; }
.fiber:nth-child(5)  { top: 34%;  background: #0088ff; width: 0; left: -6%;  animation-delay: 0.5s; animation-duration: 2.7s; }
.fiber:nth-child(6)  { top: 41%;  background: #8844ff; width: 0; left: -2%;  animation-delay: 0.9s; animation-duration: 3.4s; }
.fiber:nth-child(7)  { top: 48%;  background: #ff44aa; width: 0; left: -7%;  animation-delay: 0.4s; animation-duration: 2.6s; }
.fiber:nth-child(8)  { top: 16%;  background: #44ddff; width: 0; left: -4%;  animation-delay: 1.1s; animation-duration: 3.1s; }
.fiber:nth-child(9)  { top: 24%;  background: #ff6644; width: 0; left: -9%;  animation-delay: 0.6s; animation-duration: 2.9s; }
.fiber:nth-child(10) { top: 38%;  background: #88ff44; width: 0; left: -1%;  animation-delay: 1.3s; animation-duration: 3.3s; }
@keyframes shoot {
    0%   { width: 0;    opacity: 0; }
    10%  { opacity: 0.9; }
    50%  { width: 110%; opacity: 0.7; }
    80%  { opacity: 0.3; }
    100% { width: 110%; opacity: 0; }
}
/* The SVG is 2400x220 with xMidYMax slice, so it never distorts: wide viewports
   see more of the Bay, narrow ones crop to downtown. */
.skyline { position: absolute; inset: 0; }
.skyline svg { display: block; width: 100%; height: 100%; }

/* ===== Content: sfmix.org headings and cards ===== */
.intro { padding: 2rem 0 0.5rem; }
.intro h1 { font-size: 2.2rem; font-weight: 700; line-height: 1.2; color: var(--color-heading); }
.intro h1::after { content: ""; display: block; width: 96px; height: 4px; margin-top: 0.6rem; border-radius: 2px; background: linear-gradient(90deg, #ff6b6b, #ffa94d, #ffd43b, #69db7c, #4dabf7, #b197fc); }
.intro .lede { margin-top: 0.8rem; max-width: 62ch; color: var(--color-text-light); font-size: 1.05rem; }
.content { padding: 1.5rem 0 3rem; }
.content section + section { margin-top: 2.25rem; }
.content h2 { font-size: 1.5rem; color: var(--color-heading); margin: 0 0 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--color-border); position: relative; }
.content h2::after { content: ""; position: absolute; bottom: -2px; left: 0; width: 64px; height: 2px; background: var(--color-accent); }

.card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
.card { position: relative; display: flex; flex-direction: column; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: 1.1rem 1.2rem 1rem; color: var(--color-text); overflow: hidden; transition: box-shadow 0.2s, transform 0.2s; }
.card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
.card-librespeed::before { background: linear-gradient(90deg, #ff6b6b, #ffa94d); }
.card-openspeedtest::before { background: linear-gradient(90deg, #4dabf7, #69db7c); }
.card:hover { color: var(--color-text); text-decoration: none; box-shadow: 0 4px 12px var(--color-shadow); transform: translateY(-2px); }
.card .icon { font-size: 1.8em; line-height: 1; margin-bottom: 0.6rem; }
.card h3 { font-size: 1.15rem; color: var(--color-heading); }
.card p { margin-top: 0.25rem; font-size: 0.9rem; line-height: 1.5; color: var(--color-text-light); }
.card .go { margin-top: auto; padding-top: 0.75rem; font-size: 0.9rem; font-weight: 600; color: var(--color-link); }
.card .go::after { content: "\00a0→"; color: var(--color-accent); }
.card:hover .go { color: var(--color-accent); }

.cli { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; }
.cli-item { display: grid; grid-template-columns: 7rem 1fr; gap: 0.25rem 1rem; align-items: baseline; padding: 0.85rem 1.2rem; }
.cli-item + .cli-item { border-top: 1px solid var(--color-border); }
.cli-item .label { font-weight: 600; color: var(--color-heading); }
.cli-item .label a { color: inherit; }
.cli-item .label a:hover { color: var(--color-accent); }
.cli-item code { word-break: break-all; }
.cli-item .desc { margin-top: 0.3rem; font-size: 0.85rem; color: var(--color-text-light); }

/* ===== Footer (sfmix.org) ===== */
.site-footer { background: var(--color-header-bg); color: rgba(255,255,255,0.82); padding: 2.5rem 0 1.5rem; border-top: 4px solid var(--color-accent); font-size: 0.9rem; }
.site-footer__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; margin-bottom: 2rem; }
.site-footer h4 { color: var(--color-white); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.85rem; font-weight: 600; }
.site-footer ul { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
.site-footer a { color: rgba(255,255,255,0.85); }
.site-footer a:hover { color: var(--color-accent); }
.footer-brand img { height: 30px; width: auto; margin-bottom: 0.85rem; }
.site-footer__about { font-size: 0.85rem; line-height: 1.5; color: rgba(255,255,255,0.7); max-width: 30ch; }
.site-footer__legal { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.25rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; font-size: 0.8rem; }
.site-footer__legal a { color: var(--color-accent); font-weight: 600; }

@media (prefers-reduced-motion: reduce) {
  .rainbow-bar, .fiber { animation: none; }
  .fiber { display: none; }
  .card, .card:hover { transition: none; transform: none; }
}

/* Same breakpoint as sfmix.org: the nav collapses to the hamburger. */
@media (max-width: 1080px) {
  .nav-toggle { display: flex; }
  .site-nav { display: none; position: absolute; top: var(--header-height); left: 0; right: 0; background: var(--color-header-bg); box-shadow: 0 4px 16px var(--color-shadow); max-height: calc(100vh - var(--header-height)); overflow-y: auto; }
  .site-nav.open { display: block; }
  .nav-list { flex-direction: column; align-items: stretch; }
  .nav-link { display: flex; height: 3rem; padding: 0 1.5rem; width: 100%; }
  .dropdown-menu { position: static; box-shadow: none; border-radius: 0; background: rgba(0,0,0,0.15); }
  .dropdown-link { color: rgba(255,255,255,0.85); padding-left: 2rem; }
  .dropdown-link:hover { background: rgba(255,255,255,0.1); color: var(--color-white); }
  .theme-toggle__label { display: inline; }
}
@media (max-width: 600px) {
  .container { padding: 0 1rem; }
  .hero { height: 150px; }
  .intro h1 { font-size: 1.7rem; }
  .cli-item { grid-template-columns: 1fr; padding: 0.8rem 1rem; }
  .site-footer__grid { grid-template-columns: 1fr; gap: 1.5rem; }
  .site-footer__legal { flex-direction: column; text-align: center; }
}
</style>
{% endraw %}
</head>
<body>
<a href="#main-content" class="skip-link" data-t>Skip to main content</a>
<!-- Mirrors website/layouts/partials/nav.html and the menus in website/hugo.toml
