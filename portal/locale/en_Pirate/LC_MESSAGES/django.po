#: dashboard/views.py:1065
#, python-format
msgid ""
"A member link is down; the bundle is running at %(effective)sG of "
"%(total)sG. Redundancy is lost until the link is restored."
msgstr ""
"A crew link be sunk; the bundle sails at %(effective)sG o' %(total)sG. Yer "
"spare riggin' be lost 'til the link be mended."

